# ===========================================
# Intel Briefing - 环境变量配置模板
# ===========================================
# 复制此文件为 .env 并填入你的 API Key

# GitHub Token (用于 GitHub Trending 等)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# X/Grok API (用于 Twitter/X 舆情分析)
XAI_API_KEY=sk-your_grok_api_key_here
XAI_BASE_URL=https://api.gptsapi.net/v1/chat/completions
XAI_MODEL=grok-3

# Product Hunt API (官方 API Token)
PRODUCTHUNT_TOKEN=your_producthunt_developer_token_here

# ===========================================
# 可选配置
# ===========================================

# OpenAI API (如果使用 OpenAI 作为 LLM)
# OPENAI_API_KEY=sk-your_openai_key_here

# Gemini API (如果使用 Google Gemini)
# GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# 通知推送配置（可选）
# ===========================================

# Telegram Bot（通过 @BotFather 创建 Bot 获取 Token）
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=your_chat_id_here

# Discord Webhook（在频道设置 > 集成 > Webhook 中创建）
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
